; The Rust library lives outside the project, where dune cannot track it. The
; first rule runs on every build ((universe)) and records where the library is;
; the second copies it into the build tree as a tracked file, so a rebuilt
; libphidentify_ffi relinks the executables (link_deps in bin/ and test/).
; In dynamic mode the copy is an empty placeholder and the flags use -L/-rpath.
(rule
 (targets library_flags.sexp library_path.txt)
 (deps
  (universe)
  (env_var PHIDENTIFY_FFI_LIBDIR)
  (env_var PHIDENTIFY_FFI_LINK))
 (action
  (run %{exe:../config/library_flags.exe} %{project_root})))

(rule
 (targets libphidentify_ffi.a)
 (deps
  (universe)
  library_path.txt)
 (action
  (run sh -c
   "p=$(cat library_path.txt); if [ -n \"$p\" ]; then cp -f \"$p\" libphidentify_ffi.a; else : > libphidentify_ffi.a; fi")))

; stdlib_stable (Iarray) only exists in OxCaml switches, so its presence
; selects the OxCaml pool; everything else builds the stock OCaml 5 pool.
(library
 (name phidentify)
 (public_name phidentify)
 (libraries
  tiffgraph
  (select
   pool.ml
   from
   (stdlib_stable -> pool.oxcaml.ml)
   (-> pool.stock.ml)))
 (foreign_stubs
  (language c)
  (names phidentify_stubs)
  ; ocamlmklib reads the copied archive through c_library_flags, which dune
  ; cannot see; without this a parallel build can link a half-copied file.
  (extra_deps libphidentify_ffi.a))
 (c_library_flags
  (:include library_flags.sexp)))

; Install the Rust archive beside the OCaml library so -lphidentify_ffi
; resolves for consumers of the installed package (static mode).
(install
 (section lib)
 (package phidentify)
 (files libphidentify_ffi.a phidentify.h))
