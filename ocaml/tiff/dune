; Pure OCaml, no Rust: its own opam package so DNG walkers need no cargo.
; OxCaml switches (ocaml_version contains +ox) get a portable interface.
(library
 (name phidentify_tiff)
 (public_name phidentify-tiff))

(rule
 (targets phidentify_tiff.mli)
 (deps phidentify_tiff.mli.in)
 (action
  (with-stdout-to
   phidentify_tiff.mli
   (run sh -c "case '%{ocaml_version}' in *+ox*) echo '@@ portable';; esac; cat phidentify_tiff.mli.in"))))
